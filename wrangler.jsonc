{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protonumber",
  "main": "자동마킹.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "PROTO_DATA",
      "id": "40d0aa574fd544639513fa58882a36bd"
    },
    {
      "binding": "PROTO_KV",
      "id": "40d0aa574fd544639513fa58882a36bd"
    }
  ],
  "secrets": {
    "required": [
      "THE_ODDS_API_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROTO_DO",
        "class_name": "ProtoStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "r306_realtime_settlement_sqlite_v1",
      "new_sqlite_classes": [
        "ProtoStateDO"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
